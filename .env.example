# ==============================================================================
# SurveyForm Platform — Environment Configuration
# ==============================================================================

# Public Supabase Project URL
NEXT_PUBLIC_SUPABASE_URL=https://igglzaqyixhpsfbwpryg.supabase.co

# New Supabase Publishable API Key (starts with sb_publishable_...)
# Safe to expose in the browser when Row Level Security (RLS) is enabled.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key_here

# Legacy compatibility alias (same as publishable key)
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_your_key_here

# Supabase Secret API Key (starts with sb_secret_...)
# Used strictly in server-side functions / API route handlers. Never expose to client.
SUPABASE_SECRET_KEY=sb_secret_your_key_here
SUPABASE_SERVICE_ROLE_KEY=sb_secret_your_key_here

# Public Application URL (configured for port 3020 locally)
# Local: http://localhost:3020 | Vercel: https://your-project.vercel.app
NEXT_PUBLIC_APP_URL=http://localhost:3020
